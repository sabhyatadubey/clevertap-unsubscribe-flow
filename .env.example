# Flask Configuration
SECRET_KEY=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Sheets
SHEET_ID=your-google-sheet-id
SERVICE_ACCOUNT_JSON_BASE64=your-base64-encoded-service-account-json

# CleverTap Configuration
CLEVERTAP_PROJECT_ID=your-clevertap-project-id
CLEVERTAP_PASSCODE=your-clevertap-passcode

# Vercel Cron (protects /api/cron - set the same value in Vercel env vars)
CRON_SECRET=your-random-cron-secret

# Server Configuration
PORT=8000
