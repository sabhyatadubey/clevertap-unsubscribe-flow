# CleverTap API Credentials
CLEVERTAP_PROJECT_ID=your_project_id
CLEVERTAP_PASSCODE=your_passcode

# Google Sheets Configuration
SHEET_ID=your_sheet_id
SERVICE_ACCOUNT_FILE=service_account.json

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Allowed Team Members (comma-separated email addresses or domains)
ALLOWED_EMAILS=user1@company.com,user2@company.com,@company.com

# Flask Secret Key (use a strong random string in production)
SECRET_KEY=change-this-to-a-strong-random-string-in-production

# Railway-specific (auto-set by Railway)
RAILWAY_ENVIRONMENT=production
PORT=8000
